{
  "name": "static-web-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "data:update": "node scripts/update-legislators.mjs",
    "data:check": "node scripts/check-legislators.mjs && node --test tests/legislators.test.mjs",
    "check": "npm run format:check && npm run data:check && npm run build && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^24.19.2",
    "cheerio": "^1.2.0",
    "marked": "^18.2.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
